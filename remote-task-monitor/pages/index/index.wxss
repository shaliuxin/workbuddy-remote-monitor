/* ============================================================
   远程AI任务管家 · 界面样式
   布局原则：所有横向内容允许收缩（min-width:0），操作按钮等分，
   任何机型都不会把按钮挤出屏幕。
   ============================================================ */

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 16rpx 28rpx 40rpx;
    padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部栏 ---------- */
.topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 8rpx 4rpx 0;
}

.topbar-text {
    flex: 1;
    min-width: 0;
    padding-right: 20rpx;
}

.eyebrow {
    display: block;
    color: #1769e0;
    font-size: 19rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.title {
    display: block;
    margin-top: 10rpx;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.3;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    color: #8a919e;
    font-size: 24rpx;
    line-height: 1.5;
}

.topbar-actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 14rpx;
    padding-top: 4rpx;
}

.icon-btn {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid #e7eaf0;
    border-radius: 50%;
    background: #ffffff;
}

.icon-btn-hover {
    background: #eef2f7;
}

.icon-glyph {
    font-size: 34rpx;
    line-height: 1;
    color: #4b5563;
}

.icon-spin {
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ---------- 连接状态条 ---------- */
.conn-bar {
    display: flex;
    align-items: center;
    gap: 14rpx;
    margin-top: 20rpx;
    margin-bottom: 22rpx;
    padding: 16rpx 24rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 18rpx;
    background: #ffffff;
}

.conn-bar-error {
    border-color: #ffd9d5;
    background: #fff7f6;
}

.conn-bar-unconfigured {
    border-color: #ffe6bd;
    background: #fffbf2;
}

.conn-text {
    flex: 1;
    min-width: 0;
    color: #646a73;
    font-size: 23rpx;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.status-dot {
    flex-shrink: 0;
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background: #c9cdd4;
}

.status-dot-connecting {
    background: #faad14;
    animation: pulse 1.4s ease-in-out infinite;
}

.status-dot-connected {
    background: #2ea44f;
}

.status-dot-error {
    background: #f5222d;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
}

/* ---------- 统计 / 筛选 ---------- */
.summary {
    display: flex;
    align-items: stretch;
    margin-bottom: 20rpx;
    padding: 12rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 24rpx;
    background: #ffffff;
}

.summary-item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12rpx 2rpx;
    border-radius: 16rpx;
    transition: background 0.15s ease;
}

.summary-item:active {
    background: #f4f6f9;
}

.summary-num {
    font-size: 34rpx;
    font-weight: 700;
    line-height: 1.2;
    color: #1f2329;
}

.summary-label {
    margin-top: 4rpx;
    color: #9aa0a9;
    font-size: 20rpx;
    white-space: nowrap;
}

.summary-pending .summary-num { color: #b26a00; }
.summary-running .summary-num { color: #1769e0; }
.summary-success .summary-num { color: #21803a; }
.summary-failed .summary-num { color: #d4380d; }

.summary-active {
    background: #eef4ff;
}

.summary-active .summary-label {
    color: #1769e0;
    font-weight: 600;
}

/* ---------- 搜索 ---------- */
.search-bar {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 18rpx;
}

.search-icon {
    position: absolute;
    left: 26rpx;
    width: 24rpx;
    height: 24rpx;
    border: 3rpx solid #b7bdc6;
    border-radius: 50%;
    box-sizing: border-box;
}

.search-icon::after {
    content: '';
    position: absolute;
    right: -8rpx;
    bottom: -5rpx;
    width: 12rpx;
    height: 3rpx;
    border-radius: 3rpx;
    background: #b7bdc6;
    transform: rotate(45deg);
}

.search-input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    height: 76rpx;
    padding: 0 68rpx 0 70rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 20rpx;
    background: #ffffff;
    font-size: 27rpx;
    color: #1f2329;
}

.search-clear {
    position: absolute;
    right: 12rpx;
    width: 48rpx;
    height: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.search-clear-glyph {
    color: #9aa0a9;
    font-size: 26rpx;
}

.filter-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    margin-bottom: 18rpx;
    padding: 14rpx 22rpx;
    border-radius: 16rpx;
    background: #eef4ff;
}

.filter-hint-text {
    flex: 1;
    min-width: 0;
    color: #3f5d8a;
    font-size: 23rpx;
}

.filter-hint-reset {
    flex-shrink: 0;
    color: #1769e0;
    font-size: 23rpx;
    font-weight: 600;
}

/* ---------- 状态卡 ---------- */
.state-card {
    box-sizing: border-box;
    display: flex;
    min-height: 320rpx;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48rpx 36rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 26rpx;
    background: #ffffff;
    text-align: center;
}

.state-card-error {
    border-color: #ffd9d5;
}

.spinner {
    width: 42rpx;
    height: 42rpx;
    border: 5rpx solid #dbe8fb;
    border-top-color: #1769e0;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
}

.state-icon {
    color: #1769e0;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 1;
}

.state-title {
    margin-top: 18rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #1f2329;
}

.state-description {
    margin-top: 10rpx;
    color: #7d848e;
    font-size: 25rpx;
    line-height: 1.6;
}

.primary-button,
.secondary-button {
    width: 100%;
    margin-top: 26rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 999rpx;
    font-size: 28rpx;
}

.primary-button {
    background: #1769e0;
    color: #ffffff;
}

.secondary-button {
    margin-top: 18rpx;
    background: #f2f4f7;
    color: #4b5563;
}

.primary-button::after,
.secondary-button::after {
    border: none;
}

/* ---------- 任务卡片 ---------- */
.task-list {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.task-card {
    box-sizing: border-box;
    padding: 26rpx 26rpx 20rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 26rpx;
    background: #ffffff;
}

.task-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16rpx;
}

.task-title {
    flex: 1;
    min-width: 0;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 1.45;
    color: #1f2329;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
}

/* 标题 + 来源图标同行；标题仍可换行、不被图标挤出 */
.task-title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 10rpx;
}

/* 来源图标：带品牌色的圆角方块，内嵌字母缩写 */
.source-icon {
    flex-shrink: 0;
    width: 34rpx;
    height: 34rpx;
    border-radius: 9rpx;
    font-size: 20rpx;
    font-weight: 700;
    line-height: 34rpx;
    text-align: center;
    color: #ffffff;
    margin-top: 4rpx;
}

.source-icon-workbuddy {
    background: linear-gradient(140deg, #3d8bff, #1769e0);
}

.source-icon-marvis {
    background: linear-gradient(140deg, #a78bfa, #7148c8);
}

.head-badges {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.source-badge {
    flex-shrink: 0;
    padding: 5rpx 12rpx;
    border-radius: 8rpx;
    font-size: 20rpx;
    font-weight: 600;
    line-height: 1.5;
}

.source-badge-workbuddy {
    background: #eaf2ff;
    color: #1769e0;
}

.source-badge-marvis {
    background: #f3eefe;
    color: #7148c8;
}

.badge {
    flex-shrink: 0;
    padding: 5rpx 16rpx;
    border-radius: 8rpx;
    font-size: 21rpx;
    font-weight: 600;
    line-height: 1.5;
}

.status-pending {
    background: #f2f3f5;
    color: #8f959e;
}

.status-running {
    background: #eaf2ff;
    color: #1769e0;
}

.status-success {
    background: #e9f7ee;
    color: #21803a;
}

.status-failed {
    background: #fff0ef;
    color: #d4380d;
}

.progress-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-top: 18rpx;
}

.progress-track {
    flex: 1;
    min-width: 0;
    height: 10rpx;
    border-radius: 999rpx;
    background: #eef0f3;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: 999rpx;
    background: #1769e0;
}

.progress-fill-pending { background: #c9cdd4; }
.progress-fill-in_progress { background: #1769e0; }
.progress-fill-completed { background: #2ea44f; }
.progress-fill-failed { background: #e5484d; }

.progress-num {
    flex-shrink: 0;
    width: 72rpx;
    text-align: right;
    color: #6b7280;
    font-size: 22rpx;
    font-weight: 600;
}

.task-step {
    display: block;
    margin-top: 16rpx;
    color: #4b5563;
    font-size: 25rpx;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.task-step-mark {
    margin-right: 8rpx;
    color: #1769e0;
}

.task-desc {
    margin-top: 8rpx;
    color: #8a919e;
    font-size: 24rpx;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
}

.task-foot {
    margin-top: 20rpx;
    padding-top: 16rpx;
    border-top: 2rpx solid #f2f4f7;
}

.task-time-row {
    margin-bottom: 14rpx;
}

.task-time {
    color: #a6acb5;
    font-size: 21rpx;
}

/* 三等分操作栏：flex 等分 + min-width:0，永不溢出 */
.task-actions {
    display: flex;
    align-items: stretch;
    gap: 14rpx;
    width: 100%;
}

.task-btn {
    box-sizing: border-box;
    flex: 1 1 0;
    min-width: 0;
    height: 68rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12rpx;
    border-radius: 999rpx;
    background: #f2f5fa;
}

.task-btn-hover {
    background: #e6ebf3;
}

.task-btn-text {
    max-width: 100%;
    color: #4b5563;
    font-size: 25rpx;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.task-btn-model {
    background: #ffffff;
    border: 2rpx solid #d7e3fb;
}

.task-btn-model .task-btn-text {
    color: #1769e0;
    font-weight: 600;
}

/* ---------- 选择请求 ---------- */
.selection-box {
    margin-top: 20rpx;
    padding: 20rpx;
    border: 2rpx solid #f3ddb9;
    border-radius: 18rpx;
    background: #fffaf0;
}

.selection-prompt {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-bottom: 16rpx;
}

.selection-icon {
    flex-shrink: 0;
    width: 32rpx;
    height: 32rpx;
    line-height: 32rpx;
    text-align: center;
    border-radius: 50%;
    background: #e8930c;
    color: #ffffff;
    font-size: 21rpx;
    font-weight: 700;
}

.selection-prompt-text {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    color: #7a5a1e;
    line-height: 1.5;
    word-break: break-word;
}

.selection-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.selection-option-btn {
    flex: 1 1 44%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 16rpx 18rpx;
    line-height: 1.45;
    font-size: 26rpx;
    color: #b26a00;
    background: #ffffff;
    border: 2rpx solid #e8b968;
    border-radius: 14rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.selection-option-btn::after {
    border: none;
}

.selection-option-btn:active {
    background: #fff2d9;
}

.selection-option-btn[disabled] {
    opacity: 0.5;
}

.selection-dismiss {
    display: inline-block;
    margin-top: 16rpx;
    font-size: 22rpx;
    color: #b0b4ba;
    text-decoration: underline;
}

/* ============================================================
   底部抽屉（所有面板统一）
   ============================================================ */
.sheet-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(15, 23, 42, 0.42);
    z-index: 1000;
}

.sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    max-height: 88vh;
    padding: 18rpx 28rpx 24rpx;
    padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    border-radius: 32rpx 32rpx 0 0;
    background: #ffffff;
    box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.1);
}

.sheet-grip {
    flex-shrink: 0;
    width: 64rpx;
    height: 8rpx;
    margin: 0 auto 20rpx;
    border-radius: 999rpx;
    background: #e3e6ec;
}

.sheet-head {
    flex-shrink: 0;
}

.sheet-title {
    display: block;
    font-size: 34rpx;
    font-weight: 600;
    color: #1f2329;
}

.sheet-subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a919e;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sheet-note {
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #9aa0a9;
    line-height: 1.5;
}

.sheet-body {
    margin-top: 16rpx;
}

.sheet-close-btn {
    flex-shrink: 0;
    width: 100%;
    margin-top: 20rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 999rpx;
    background: #f2f4f7;
    color: #4b5563;
    font-size: 28rpx;
}

.sheet-close-btn::after {
    border: none;
}

/* ---------- 指令面板 ---------- */
.command-result {
    margin-top: 8rpx;
    padding: 28rpx 24rpx;
    border-radius: 18rpx;
    background: #e9f7ee;
    color: #12813f;
    font-size: 27rpx;
    text-align: center;
    line-height: 1.6;
}

.marshal-note {
    margin-top: 12rpx;
    padding: 22rpx 24rpx;
    border-radius: 16rpx;
    background: #f3eefe;
    color: #7148c8;
    font-size: 25rpx;
    line-height: 1.7;
}

.command-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-top: 20rpx;
}

.command-btn {
    flex: 1 1 44%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    height: 80rpx;
    line-height: 80rpx;
    border-radius: 16rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 27rpx;
    padding: 0 12rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.command-btn::after {
    border: none;
}

.command-btn[disabled] {
    opacity: 0.5;
}

.text-input-group {
    margin-top: 26rpx;
}

.text-input-label {
    display: block;
    margin-bottom: 14rpx;
    font-size: 26rpx;
    color: #4b5563;
}

.text-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 170rpx;
    padding: 20rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 16rpx;
    background: #f7f8fa;
    font-size: 27rpx;
    line-height: 1.6;
    color: #1f2329;
}

.text-send-btn {
    width: 100%;
    margin-top: 18rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 999rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 28rpx;
}

.text-send-btn::after {
    border: none;
}

/* ---------- 对话面板 ---------- */
.conv-body {
    height: 48vh;
    margin-top: 16rpx;
}

.conv-loading,
.conv-error,
.conv-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    padding: 60rpx 20rpx;
}

.conv-loading-text,
.conv-error-text,
.conv-empty {
    font-size: 26rpx;
    color: #8a919e;
}

.conv-error-icon {
    width: 56rpx;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    border-radius: 50%;
    background: #fde2e2;
    color: #d93c3c;
    font-size: 30rpx;
    font-weight: 700;
}

.conv-error-text {
    color: #d93c3c;
}

.conv-content {
    padding: 4rpx;
}

.conv-role-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 14rpx;
}

.conv-role-tag {
    padding: 4rpx 16rpx;
    border-radius: 8rpx;
    font-size: 21rpx;
    font-weight: 600;
}

.conv-role-assistant {
    background: #eaf2ff;
    color: #1769e0;
}

.conv-role-user {
    background: #e9f7ee;
    color: #12813f;
}

.conv-time {
    font-size: 21rpx;
    color: #b0b4ba;
}

.conv-text {
    display: block;
    font-size: 27rpx;
    color: #1f2329;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
}

.conv-more {
    display: block;
    margin-top: 18rpx;
    font-size: 21rpx;
    color: #b0b4ba;
    text-align: center;
}

/* ---------- 服务器面板 ---------- */
.server-list {
    height: 42vh;
    margin-top: 18rpx;
}

.server-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    margin-bottom: 14rpx;
    padding: 20rpx 22rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 18rpx;
    background: #fafbfc;
}

.server-item-active {
    border-color: #1769e0;
    background: #f2f7ff;
}

.server-item-main {
    flex: 1;
    min-width: 0;
}

.server-item-head {
    display: flex;
    align-items: center;
    gap: 12rpx;
    min-width: 0;
}

.server-name {
    min-width: 0;
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.server-badge {
    flex-shrink: 0;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 19rpx;
}

.server-endpoint {
    display: block;
    margin-top: 6rpx;
    font-size: 21rpx;
    color: #9aa0a9;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.server-item-ops {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.op-btn {
    margin: 0;
    padding: 0 18rpx;
    line-height: 1.9;
    font-size: 22rpx;
    background: #ffffff;
    border: 2rpx solid #dde1e8;
    border-radius: 10rpx;
    color: #4b5563;
}

.op-btn::after {
    border: none;
}

.op-btn-danger {
    color: #d4380d;
    border-color: #f2c6bd;
}

.server-empty {
    padding: 48rpx 0;
    text-align: center;
    color: #b0b4ba;
    font-size: 25rpx;
}

.add-server-btn {
    flex-shrink: 0;
    width: 100%;
    margin-top: 16rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 16rpx;
    background: #f2f7ff;
    color: #1769e0;
    border: 2rpx dashed #a9c4f0;
    font-size: 27rpx;
    font-weight: 600;
}

.add-server-btn::after {
    border: none;
}

.server-form {
    margin-top: 16rpx;
}

.form-title {
    display: block;
    margin-bottom: 4rpx;
    font-size: 29rpx;
    font-weight: 600;
    color: #1f2329;
}

.field-group {
    margin-top: 22rpx;
}

.field-label {
    display: block;
    margin-bottom: 10rpx;
    font-size: 25rpx;
    color: #4b5563;
}

.field-input {
    box-sizing: border-box;
    width: 100%;
    height: 80rpx;
    padding: 0 20rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 14rpx;
    background: #f7f8fa;
    font-size: 27rpx;
    color: #1f2329;
}

.field-tip {
    display: block;
    margin-top: 8rpx;
    font-size: 21rpx;
    color: #9aa0a9;
    line-height: 1.5;
}

/* Token 输入框 + 一键清除 */
.token-field {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.token-field-input {
    flex: 1;
    min-width: 0;
}

.token-clear {
    flex-shrink: 0;
    height: 80rpx;
    padding: 0 24rpx;
    border-radius: 14rpx;
    background: #f2f3f5;
    color: #6b7280;
    font-size: 25rpx;
    line-height: 80rpx;
    text-align: center;
}

.token-clear-hover {
    background: #e5e7eb;
    color: #374151;
}

.sheet-error {
    display: block;
    margin-top: 18rpx;
    padding: 14rpx 18rpx;
    border-radius: 14rpx;
    background: #fff0ef;
    color: #d4380d;
    font-size: 23rpx;
    line-height: 1.5;
}

.panel-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 28rpx;
}

.sheet-button {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    height: 84rpx;
    line-height: 84rpx;
    padding: 0 12rpx;
    border-radius: 999rpx;
    background: #f2f4f7;
    color: #1f2329;
    font-size: 27rpx;
}

.sheet-button::after {
    border: none;
}

.sheet-button-primary {
    background: #1769e0;
    color: #ffffff;
}

/* ---------- 模型面板 ---------- */
.model-search {
    flex-shrink: 0;
    margin-top: 18rpx;
}

.model-status {
    padding: 48rpx 0;
    text-align: center;
    font-size: 25rpx;
    color: #8a919e;
}

.model-status-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16rpx;
    color: #d4380d;
}

.model-status-error .sheet-button {
    flex: none;
    width: auto;
    height: 64rpx;
    line-height: 64rpx;
    padding: 0 32rpx;
    font-size: 24rpx;
}

.model-list {
    height: 46vh;
    margin-top: 16rpx;
}

.model-item {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 12rpx;
    padding: 20rpx 22rpx;
    border: 2rpx solid #eaedf2;
    border-radius: 16rpx;
    background: #fafbfc;
}

.model-item-current {
    border-color: #1769e0;
    background: #eef4ff;
}

.model-item-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.model-item-name {
    font-size: 27rpx;
    color: #1f2329;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.model-item-id {
    margin-top: 2rpx;
    font-size: 21rpx;
    color: #9aa0a9;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.model-item-credits {
    flex-shrink: 0;
    font-size: 21rpx;
    color: #d97706;
}

.model-item-badge {
    flex-shrink: 0;
    padding: 2rpx 10rpx;
    border: 2rpx solid #93c5fd;
    border-radius: 8rpx;
    font-size: 19rpx;
    color: #2563eb;
}

.model-item-check {
    flex-shrink: 0;
    font-size: 28rpx;
    color: #1769e0;
}
