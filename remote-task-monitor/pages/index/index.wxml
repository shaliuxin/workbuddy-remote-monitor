<view class="page">
    <!-- 顶部栏：标题 + 图标操作，文字按钮不再挤占标题宽度 -->
    <view class="topbar">
        <view class="topbar-text">
            <text class="eyebrow">WORKBUDDY TASK MONITOR</text>
            <text class="title">{{title}}</text>
            <text class="subtitle">{{subtitle}}</text>
        </view>
        <view class="topbar-actions">
            <view
                class="icon-btn"
                wx:if="{{connectionState === 'connected'}}"
                bindtap="handleRetry"
                hover-class="icon-btn-hover"
            >
                <text class="icon-glyph {{refreshing ? 'icon-spin' : ''}}">↻</text>
            </view>
            <view class="icon-btn" bindtap="openSettings" hover-class="icon-btn-hover">
                <text class="icon-glyph">⚙</text>
            </view>
        </view>
    </view>

    <!-- 连接状态条 -->
    <view class="conn-bar conn-bar-{{connectionState}}">
        <view class="status-dot status-dot-{{connectionState}}"></view>
        <text class="conn-text">{{connectionMessage}}</text>
    </view>

    <view class="state-card" wx:if="{{connectionState === 'connecting'}}">
        <view class="spinner"></view>
        <text class="state-title">正在连接</text>
        <text class="state-description">正在建立与 WorkBuddy 的连接…</text>
    </view>

    <view class="state-card state-card-error" wx:elif="{{connectionState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">连接失败</text>
        <text class="state-description">{{errorMessage}}</text>
        <button class="primary-button" bindtap="handleRetry">重新连接</button>
        <button class="secondary-button" bindtap="openSettings">修改连接配置</button>
    </view>

    <view class="state-card" wx:elif="{{connectionState === 'unconfigured'}}">
        <text class="state-icon">⚙</text>
        <text class="state-title">尚未连接 WorkBuddy</text>
        <text class="state-description">请在电脑端启动监控服务端，然后填写连接地址与 Token。</text>
        <button class="primary-button" bindtap="openSettings">配置连接</button>
    </view>

    <block wx:else>
        <!-- 统计 / 筛选 -->
        <view class="summary" wx:if="{{viewState !== 'loading'}}">
            <view class="summary-item {{statusFilter === 'all' ? 'summary-active' : ''}}" data-filter="all" bindtap="handleFilterTap">
                <text class="summary-num">{{summary.total}}</text>
                <text class="summary-label">全部</text>
            </view>
            <view class="summary-item summary-pending {{statusFilter === 'pending' ? 'summary-active' : ''}}" data-filter="pending" bindtap="handleFilterTap">
                <text class="summary-num">{{summary.pending}}</text>
                <text class="summary-label">待处理</text>
            </view>
            <view class="summary-item summary-running {{statusFilter === 'in_progress' ? 'summary-active' : ''}}" data-filter="in_progress" bindtap="handleFilterTap">
                <text class="summary-num">{{summary.running}}</text>
                <text class="summary-label">进行中</text>
            </view>
            <view class="summary-item summary-success {{statusFilter === 'completed' ? 'summary-active' : ''}}" data-filter="completed" bindtap="handleFilterTap">
                <text class="summary-num">{{summary.success}}</text>
                <text class="summary-label">已完成</text>
            </view>
            <view class="summary-item summary-failed {{statusFilter === 'failed' ? 'summary-active' : ''}}" data-filter="failed" bindtap="handleFilterTap">
                <text class="summary-num">{{summary.failed}}</text>
                <text class="summary-label">失败</text>
            </view>
        </view>

        <!-- 搜索框 -->
        <view class="search-bar" wx:if="{{viewState === 'ready' || viewState === 'filtered-empty'}}">
            <view class="search-icon"></view>
            <input class="search-input" placeholder="搜索任务标题或描述" value="{{keyword}}" bindinput="handleKeywordInput" confirm-type="search" />
            <view class="search-clear" wx:if="{{keyword !== ''}}" bindtap="handleClearKeyword">
                <text class="search-clear-glyph">✕</text>
            </view>
        </view>

        <!-- 当前筛选提示 -->
        <view class="filter-hint" wx:if="{{viewState === 'ready' && (statusFilter !== 'all' || keyword !== '')}}">
            <text class="filter-hint-text">已筛选 {{filteredCount}} / {{summary.total}} 个任务</text>
            <text class="filter-hint-reset" bindtap="handleResetFilter">清除</text>
        </view>

        <view class="state-card" wx:if="{{viewState === 'loading'}}">
            <view class="spinner"></view>
            <text class="state-title">正在加载</text>
            <text class="state-description">请稍候，任务列表马上准备好。</text>
        </view>

        <view class="state-card" wx:elif="{{viewState === 'empty'}}">
            <text class="state-icon">○</text>
            <text class="state-title">暂无任务</text>
            <text class="state-description">WorkBuddy 当前没有正在执行的任务。</text>
        </view>

        <view class="state-card" wx:elif="{{viewState === 'filtered-empty'}}">
            <text class="state-icon">🔍</text>
            <text class="state-title">没有匹配的任务</text>
            <text class="state-description">当前筛选条件下没有任务，试试换个条件。</text>
            <button class="secondary-button" bindtap="handleResetFilter">清除筛选</button>
        </view>

        <view class="state-card state-card-error" wx:elif="{{viewState === 'error'}}">
            <text class="state-icon">!</text>
            <text class="state-title">加载失败</text>
            <text class="state-description">{{errorMessage}}</text>
            <button class="primary-button" bindtap="handleRetry">重试</button>
        </view>

        <!-- 任务列表：卡片纵向布局，操作栏独立一行三等分，永不溢出 -->
        <view class="task-list" wx:else>
            <view class="task-card" wx:for="{{visibleTasks}}" wx:key="id">
                <view class="task-head">
                    <text class="task-title">{{item.title}}</text>
                    <view class="head-badges">
                        <view class="source-badge" wx:if="{{item.isMarvis}}">Marvis</view>
                        <view class="badge {{item.statusCls}}">{{item.statusText}}</view>
                    </view>
                </view>

                <view class="progress-row">
                    <view class="progress-track">
                        <view class="progress-fill progress-fill-{{item.status}}" style="width: {{item.progress}}%;"></view>
                    </view>
                    <text class="progress-num">{{item.progressText}}</text>
                </view>

                <text class="task-step" wx:if="{{item.stepSubject}}">
                    <text class="task-step-mark">▸</text>{{item.stepSubject}}
                </text>
                <text class="task-desc" wx:if="{{item.description}}">{{item.description}}</text>

                <!-- 任务发来的选择请求：展示选项按钮，点选即回传 -->
                <view class="selection-box" wx:if="{{selectionRequests[item.id]}}">
                    <view class="selection-prompt">
                        <text class="selection-icon">?</text>
                        <text class="selection-prompt-text">{{selectionRequests[item.id].prompt}}</text>
                    </view>
                    <view class="selection-options">
                        <button
                            class="selection-option-btn"
                            wx:for="{{selectionRequests[item.id].options}}"
                            wx:for-item="opt"
                            wx:key="value"
                            data-taskid="{{item.id}}"
                            data-requestid="{{selectionRequests[item.id].requestId}}"
                            data-value="{{opt.value}}"
                            data-label="{{opt.label}}"
                            bindtap="handleSelectOption"
                            disabled="{{sendingCommand}}"
                        >{{opt.label}}</button>
                    </view>
                    <text
                        class="selection-dismiss"
                        data-taskid="{{item.id}}"
                        bindtap="handleDismissSelection"
                    >忽略</text>
                </view>

                <view class="task-foot">
                    <view class="task-time-row">
                        <text class="task-time">{{item.updatedText}} 更新</text>
                    </view>
                    <view class="task-actions">
                        <view class="task-btn" data-id="{{item.id}}" bindtap="openConvPanel" hover-class="task-btn-hover">
                            <text class="task-btn-text">对话</text>
                        </view>
                        <view class="task-btn" data-id="{{item.id}}" bindtap="openCommandPanel" hover-class="task-btn-hover">
                            <text class="task-btn-text">操作</text>
                        </view>
                        <view class="task-btn task-btn-model" wx:if="{{!item.isMarvis}}" data-id="{{item.id}}" bindtap="openModelPanel" hover-class="task-btn-hover">
                            <text class="task-btn-text task-btn-model-text">{{item.modelShort || '选择模型'}}</text>
                        </view>
                        <view class="task-btn task-btn-model" wx:else>
                            <text class="task-btn-text task-btn-model-text">{{item.modelShort || 'Marvis 模型'}}</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </block>

    <!-- 指令面板（底部抽屉） -->
    <view class="sheet-mask" wx:if="{{commandPanelOpen}}" bindtap="closeCommandPanel"></view>
    <view class="sheet sheet-command" wx:if="{{commandPanelOpen}}">
        <view class="sheet-grip"></view>
        <view class="sheet-head">
            <text class="sheet-title">任务操作</text>
            <text class="sheet-subtitle">{{selectedTaskTitle}}</text>
        </view>

        <view class="sheet-body">
                <view class="command-result" wx:if="{{commandResult !== ''}}">{{commandResult}}</view>

                <view wx:else>
                    <view class="marshal-note" wx:if="{{selectedTaskIsMarvis}}">
                        Marvis 任务支持「审批 / 选项回传」等交互操作；当前版本暂不支持手机远程发消息、中止和切换模型。
                    </view>

                    <view class="command-buttons" wx:if="{{commandButtons.length > 0}}">
                        <button class="command-btn" wx:for="{{commandButtons}}" wx:key="command" data-command="{{item.command}}" bindtap="handleCommandTap" disabled="{{sendingCommand}}">
                            {{item.text}}
                        </button>
                    </view>

                    <view class="text-input-group" wx:if="{{!selectedTaskIsMarvis}}">
                        <text class="text-input-label">发送消息</text>
                        <textarea class="text-input" placeholder="输入文字发送给任务…" value="{{textMessage}}" bindinput="handleTextMessageInput" maxlength="500" disabled="{{sendingCommand}}" />
                        <button class="text-send-btn" bindtap="handleSendText" disabled="{{sendingCommand || textMessage === ''}}">发送</button>
                    </view>
                </view>
        </view>

        <button class="sheet-close-btn" bindtap="closeCommandPanel" disabled="{{sendingCommand}}">关闭</button>
    </view>

    <!-- 对话内容面板（底部抽屉） -->
    <view class="sheet-mask" wx:if="{{convPanelOpen}}" bindtap="closeConvPanel"></view>
    <view class="sheet sheet-conv" wx:if="{{convPanelOpen}}">
        <view class="sheet-grip"></view>
        <view class="sheet-head">
            <text class="sheet-title">任务对话</text>
            <text class="sheet-subtitle">{{selectedTaskTitle}}</text>
        </view>

        <scroll-view class="conv-body" scroll-y="true">
            <view class="conv-loading" wx:if="{{convLoading}}">
                <view class="spinner"></view>
                <text class="conv-loading-text">正在读取对话内容…</text>
            </view>

            <view class="conv-error" wx:elif="{{convError !== ''}}">
                <text class="conv-error-icon">!</text>
                <text class="conv-error-text">{{convError}}</text>
            </view>

            <view class="conv-empty" wx:elif="{{convText === ''}}">
                <text>暂无可展示的对话内容</text>
            </view>

            <view class="conv-content" wx:else>
                <view class="conv-role-row">
                    <text class="conv-role-tag {{convRole === 'user' ? 'conv-role-user' : 'conv-role-assistant'}}">{{convRole === 'user' ? '用户' : '助手'}}</text>
                    <text class="conv-time" wx:if="{{convTime !== ''}}">{{convTime}}</text>
                </view>
                <text class="conv-text">{{convText}}</text>
                <text class="conv-more" wx:if="{{convHasMore}}">内容较长，仅显示最后一条对话的摘要</text>
            </view>
        </scroll-view>

        <button class="sheet-close-btn" bindtap="closeConvPanel">关闭</button>
    </view>

    <!-- 服务器管理面板（底部抽屉） -->
    <view class="sheet-mask" wx:if="{{settingsOpen}}" bindtap="closeSettings"></view>
    <view class="sheet sheet-server" wx:if="{{settingsOpen}}">
        <view class="sheet-grip"></view>
        <view class="sheet-head">
            <text class="sheet-title">服务器管理</text>
            <text class="sheet-subtitle">可保存多台电脑的监控服务，点击即可切换连接</text>
        </view>

        <!-- 已保存的服务器列表 -->
        <block wx:if="{{!editingServer}}">
            <scroll-view class="server-list" scroll-y>
                <view
                    class="server-item {{activeServerId === item.id ? 'server-item-active' : ''}}"
                    wx:for="{{servers}}"
                    wx:key="id"
                >
                    <view class="server-item-main" data-id="{{item.id}}" bindtap="handleSwitchServer">
                        <view class="server-item-head">
                            <text class="server-name">{{item.name}}</text>
                            <view class="server-badge" wx:if="{{activeServerId === item.id}}">当前</view>
                        </view>
                        <text class="server-endpoint">{{item.endpoint}}</text>
                    </view>
                    <view class="server-item-ops">
                        <button class="op-btn" size="mini" data-id="{{item.id}}" catchtap="handleEditServer">编辑</button>
                        <button class="op-btn op-btn-danger" size="mini" data-id="{{item.id}}" catchtap="handleDeleteServer">删除</button>
                    </view>
                </view>

                <view class="server-empty" wx:if="{{servers.length === 0}}">
                    <text>还没有保存任何服务器</text>
                </view>
            </scroll-view>

            <button class="add-server-btn" bindtap="handleAddServer">＋ 添加服务器</button>
            <button class="sheet-close-btn" bindtap="closeSettings">关闭</button>
        </block>

        <!-- 新增/编辑服务器表单 -->
        <view class="server-form" wx:if="{{editingServer}}">
            <text class="form-title">{{editingServer.id ? '编辑服务器' : '添加服务器'}}</text>

            <view class="field-group">
                <text class="field-label">名称（可选）</text>
                <input class="field-input" placeholder="如：家里电脑 / 公司电脑" value="{{editingServer.name}}" bindinput="handleEditingNameInput" />
                <text class="field-tip">留空则自动用地址作为名称</text>
            </view>

            <view class="field-group">
                <text class="field-label">连接地址</text>
                <input class="field-input" placeholder="ws://192.168.1.5:48787/ws" value="{{editingServer.endpoint}}" bindinput="handleEditingEndpointInput" />
                <text class="field-tip">需以 ws:// 开头、以 /ws 结尾</text>
            </view>

            <view class="field-group">
                <text class="field-label">Token</text>
                <input class="field-input" password placeholder="启动时打印的 Token" value="{{editingServer.token}}" bindinput="handleEditingTokenInput" />
            </view>

            <text class="sheet-error" wx:if="{{settingsError !== ''}}">{{settingsError}}</text>

            <view class="panel-actions">
                <button class="sheet-button" bindtap="handleCancelEdit" disabled="{{savingSettings}}">取消</button>
                <button class="sheet-button sheet-button-primary" bindtap="handleSaveEditingServer" disabled="{{savingSettings}}">保存</button>
            </view>
        </view>
    </view>
</view>

<!-- 模型选择面板（底部抽屉） -->
<view class="sheet-mask" wx:if="{{modelPanelOpen}}" bindtap="closeModelPanel"></view>
<view class="sheet sheet-model" wx:if="{{modelPanelOpen}}">
    <view class="sheet-grip"></view>
    <view class="sheet-head">
        <text class="sheet-title">选择模型</text>
        <text class="sheet-subtitle">{{modelPanelTaskTitle}}</text>
        <text class="sheet-note">当前：{{modelPanelCurrent || '未设置'}} · 切换后下一轮对话生效</text>
    </view>

    <view class="model-search">
        <input class="field-input" placeholder="搜索模型…" value="{{modelKeyword}}" bindinput="handleModelKeyword" />
    </view>

    <view wx:if="{{modelsLoading}}" class="model-status">
        <text>正在获取模型清单…</text>
    </view>
    <view wx:elif="{{modelsError !== ''}}" class="model-status model-status-error">
        <text>{{modelsError}}</text>
        <button class="sheet-button" size="mini" bindtap="loadModels">重试</button>
    </view>
    <scroll-view wx:else scroll-y class="model-list">
        <view
            class="model-item {{m.id === modelPanelCurrent ? 'model-item-current' : ''}}"
            wx:for="{{visibleModels}}"
            wx:for-item="m"
            wx:key="id"
            data-modelid="{{m.id}}"
            bindtap="handlePickModel"
        >
            <view class="model-item-main">
                <text class="model-item-name">{{m.name}}</text>
                <text class="model-item-id" wx:if="{{m.name !== m.id}}">{{m.id}}</text>
            </view>
            <text class="model-item-credits" wx:if="{{m.credits}}">{{m.credits}}</text>
            <text class="model-item-badge" wx:if="{{m.custom}}">自定义</text>
            <text class="model-item-check" wx:if="{{m.id === modelPanelCurrent}}">✓</text>
        </view>
        <view wx:if="{{visibleModels.length === 0}}" class="model-status">
            <text>没有匹配的模型</text>
        </view>
    </scroll-view>

    <button class="sheet-close-btn" bindtap="closeModelPanel" disabled="{{switchingModel}}">关闭</button>
</view>
